.vscode/
.idea/
*.swp
*~

# npm noise
npm-debug.log*
yarn-error.log*
.npm/

# machine-local Claude Code settings (shared settings.json stays tracked)
.claude/settings.local.json

# local browser-test builds
test-*.html
